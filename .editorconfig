root = true

# ── 전역 기본 (모든 파일) ──────────────────────────────
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
# ── 기본 포맷 ──────────────────────────────────────────
indent_size = 4
max_line_length = 120

# ── Ktlint 기본 설정 ───────────────────────────────────
# ktlint_official 스타일 적용 (대부분의 standard & naming 규칙 자동 활성화)
ktlint_code_style = ktlint_official

# 백틱으로 감싼 식별자(한글·공백 포함 테스트 함수명 등)는 lint 예외 처리
ktlint_ignore_back_ticked_identifier = true

# ── Compose 맞춤 설정 ──────────────────────────────────
# Composable 함수는 대문자로 시작하는 것을 허용 (Compose 개발 시 필수)
ktlint_function_naming_ignore_when_annotated_with = Composable

# ── Trailing Comma 강제 (Kotlin 1.4+ 트렌드) ───────────
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ktlint_standard_trailing-comma-on-call-site = enabled
ktlint_standard_trailing-comma-on-declaration-site = enabled

# ── Import & 패키지 설정 ───────────────────────────────
# 와일드카드(*) import 완전 금지 (명시적 import 강제)
ij_kotlin_packages_to_use_import_on_demand = unset
ktlint_standard_no-wildcard-imports = enabled

# ── 명시적 비활성화 규칙 (호불호 및 생산성 고려) ────────
# 멀티라인 표현식에서 우변을 무조건 다음 줄로 넘기는 규칙 (코드가 너무 길어지는 현상 방지)
ktlint_standard_multiline-expression-wrapping = disabled

# 함수 시그니처: 인자가 2개 이상이면 한 줄에 들어가더라도 파라미터를 각 줄로 강제 개행한다.
ktlint_standard_function-signature = enabled
ktlint_function_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 2

# 파라미터 리스트 내부 공백 일관성 (가독성을 위한 수동 공백 허용)
ktlint_standard_parameter-list-spacing = disabled

# 클래스 시그니처 자동 정렬 끄기 (Hilt @Inject 및 긴 제네릭 상속 시 줄바꿈 강제 방지)
ktlint_standard_class-signature = disabled
ktlint_standard_annotation = disabled

# 단일 선언 파일의 파일명 강제 끄기 (라우트 묶음 등 *Destinations.kt 컨테이너 명명 허용)
ktlint_standard_filename = disabled

# ── 기타 파일 포맷 ─────────────────────────────────────
[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Markdown은 줄 끝 공백 2칸이 강제 줄바꿈 의미를 가지므로 보존
trim_trailing_whitespace = false
